# Copy to .env. Never commit real credentials.
NEXORA_HOST=127.0.0.1
NEXORA_PORT=8000
NEXORA_ALLOWED_HOSTS=localhost,127.0.0.1
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required to make a server environment key available to one real faculty account.
ENV_KEY_OWNER_EMAIL=you@college.edu
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only set true behind HTTPS. Keep false for localhost HTTP.
COOKIE_SECURE=false
